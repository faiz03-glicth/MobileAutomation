# Copy to .env (gitignored) and fill in. In CI, set the same names as secret variables instead:
# real environment variables win over this file. Details: docs/test-accounts.md, docs/device-setup.md.

# ----- App and device --------------------------------------------------------------------------------
# Package of the build under test. com.faiz.streak = EAS build; com.faiz.streak.local = `APP_VARIANT=local`
# build made on this laptop (installs next to it, so tests don't wipe the everyday app's data).
APP_ID=com.faiz.streak
# adb serial of the phone (`adb devices`). Leave empty when exactly one device is connected.
DEVICE_ID=

# ----- Dummy account (email sign-in) -----------------------------------------------------------------
# Streak has no passwords: email sign-in sends a 6-digit code. Use a dedicated address you control.
TEST_USER_EMAIL=
# The runner asks Supabase for a valid code for TEST_USER_EMAIL (admin generate_link). The key never leaves
# the runner process: Maestro only gets a one-run localhost URL. Supabase > Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Google account (interactive) ------------------------------------------------------------------
# The Google test account's address (private: keep it here, never in a committed file). Never store its
# password. It must be added to the phone; a person finishes Google's prompts.
GOOGLE_TEST_ACCOUNT=
# Tap the account in Google's account chooser automatically (true) or leave the whole step to a person.
GOOGLE_AUTO_PICK=true
# How long the test waits for that person (ms).
HUMAN_TIMEOUT_MS=180000

# ----- Tuning ------------------------------------------------------------------------------------------
# Multiplies every wait (1.5 or 2 for a slow phone or a CI emulator).
TIMEOUT_SCALE=1
# The phone's date (YYYY-MM-DD) when it differs from the laptop's (time zones, runs near midnight).
TODAY=

# Optional explicit tool paths (normally found automatically).
MAESTRO_BIN=
ADB_BIN=
